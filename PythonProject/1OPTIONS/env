# ══════════════════════════════════════════════════════════════════════
#  1OPTIONS — data source configuration
#
#  Copy this file next to nse_chain_server.py and edit. It is read at
#  startup; command-line flags still override anything set here.
#  Keep it out of version control: it holds broker credentials.
# ══════════════════════════════════════════════════════════════════════

# ── Which market-data adapter to use ─────────────────────────────────
#   nse    = scrape NSE's public option chain (no account, ~3-5 min stale
#            OI, needs the cookie warm-up, polled on a timer)
#   fyers  = Fyers API v3 (real-time WebSocket, depth, traded volume)
#   zerodha = Zerodha Kite Connect (real-time WebSocket, 5-level depth for
#            every strike on screen, traded volume; needs the paid Connect plan)
#   arrow  = Arrow / iRage broker API (real-time, WebSocket streaming,
#            OI + Greeks + volume; polling is switched OFF automatically)
#   Every broker source switches NSE polling OFF automatically.
DATA_SOURCE=zerodha

# ── Fyers API v3 ─────────────────────────────────────────────────────
# The richest source available here: real-time WebSocket ticks, genuine OHLC
# with TRADED VOLUME, bid/ask per strike and Level-2 market depth. Set
# DATA_SOURCE=fyers to use it.
#
# Create an app at https://myapi.fyers.in to get the id and secret. Access
# tokens expire DAILY and the login is interactive, so run:
#     python3 fyers_login.py
# each morning - it writes .fyers_token, which the adapter reads.
FYERS_CLIENT_ID=X2VQ4FPOO3-100
FYERS_SECRET_KEY=E857FEHMKY
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html
# Optional: paste a token directly instead of using the token file.
FYERS_ACCESS_TOKEN=
# Indices to stream, and strikes either side of ATM.
FYERS_SYMBOLS=NIFTY,BANKNIFTY
FYERS_STRIKE_COUNT=25
# Tick pushes to browsers per second (coalesced; the UI cannot use more).
FYERS_PUSH_HZ=10
# Where fyers_login.py also drops a PLAIN-TEXT copy of the token, for the
# historical-data downloader which reads a bare token rather than JSON.
# Defaults to ../NSE_SYNC/ relative to the login script.
FYERS_SYNC_DIR=../NSE_SYNC

# ── Arrow (arrow.trade / iRage Broking) ──────────────────────────────
# Create an app in Arrow's Trading API section to get these.
ARROW_APP_ID=
ARROW_API_SECRET=

# Unattended daily login (auto_login with TOTP). Preferred for a server
# that restarts on its own: no token pasting each morning.
ARROW_USER_ID=
ARROW_PASSWORD=
ARROW_TOTP_SECRET=

# Alternative: paste a token obtained manually. Used only when the
# auto-login fields above are blank. Tokens are short-lived.
ARROW_ACCESS_TOKEN=

# Underlyings to stream, and how many strikes either side of ATM.
ARROW_SYMBOLS=NIFTY,BANKNIFTY
ARROW_STRIKE_COUNT=20

# Seconds between option-chain refreshes when streaming is unavailable.
# Arrow's chain endpoint is REST; the WebSocket carries the live ticks.
ARROW_CHAIN_INTERVAL=3

# ── Server ───────────────────────────────────────────────────────────
NSE_LAN=true
NSE_PORT=8765
NSE_CHAIN_TTL=8

# Fill chart gaps from Yahoo Finance when NSE data is missing (no account
# needed). Never overwrites NSE prices - gap-fill only. false = honest gaps.
NSE_YAHOO_BACKFILL=true

# Background poller — only meaningful for DATA_SOURCE=nse.
# It is force-disabled when an adapter streams its own data.
NSE_POLL=NIFTY,BANKNIFTY
NSE_POLL_INTERVAL=5

# Indicator warm-up: previous trading sessions of 1-minute bars run through
# EMAs, RSI, Bollinger, Heikin Ashi, EMA cross and the Trend Target Ribbon
# before 09:15, so they are settled at the open (only today is drawn).
# Weekends and NSE holidays are skipped. Each session is one history call,
# once, then kept on disk (warm_cache/); today's bars are saved after 15:45
# so tomorrow normally costs no call at all. 0 turns warm-up off; max 5.
NSE_WARM_DAYS=2
# Extra closures beyond the built-in 2026 NSE holiday list (comma separated):
# NSE_HOLIDAYS=YYYY-MM-DD,YYYY-MM-DD

# ── Alert engine thresholds ──────────────────────────────────────────
NSE_ALERT_OI_PCT=3
NSE_ALERT_PREM_PCT=6
NSE_ALERT_NEAR_PCT=1.5
NSE_ALERT_WINDOW=90
NSE_ALERT_COOLDOWN=300
NSE_ALERT_MAX=6
NSE_ALERT_MIN_OI=4000

# ── Index constituent weights ────────────────────────────────────────
# The Nifty/BankNifty contribution widget needs each stock's index weight.
# These live in index_weights.json next to the server, NOT in this file.
#
# NSE rebalances quarterly (Mar/Jun/Sep/Dec) and occasionally swaps a
# constituent outright. A stale table drifts silently - every point figure
# stays plausible while being wrong - so refresh after each rebalance:
#
#   set this to true, restart once, then set it back to false
#   (leaving it on costs an NSE round trip on every single boot)
#
# Or refresh without restarting:  curl localhost:8765/api/refresh-weights
#
# The dashboard shows the source and date next to the breadth reading, so
# you can see at a glance whether the table is current.
NSE_REFRESH_WEIGHTS=false

# ── Weekly disk cleanup ──────────────────────────────────────────────
# Nothing deleted archive files before this, so replay/ grew without limit -
# about 32 MB a day for two symbols, which is 7.8 GB a year.
#
# Retention differs per folder because the data differs:
#   replay/   the only record of what the chain looked like minute by minute,
#             and unreconstructable once gone. Claims on Trial reads across
#             dates, so 60 days keeps roughly two months of verdicts.
#   ticks/    20 KB a day. Kept a full year because deleting it saves nothing
#             and costs restart recovery.
#   bhavcopy/ only yesterday's file is read, and every file is re-downloadable
#             from NSE - the cheapest thing here to lose.
#
# Runs weekly. Preview without deleting:  curl localhost:8765/api/cleanup?dry=1
NSE_CLEANUP=true
NSE_KEEP_REPLAY_DAYS=60
NSE_KEEP_TICKS_DAYS=365
NSE_KEEP_BHAV_DAYS=30

# ── Flow alert strike band ───────────────────────────────────────────
# Which strikes generate option-flow alerts, measured in sigma of the
# expected session move rather than a fixed percentage of spot.
#
# A fixed band is wrong differently on each instrument - 1.5% is 2.2 sigma
# on Nifty but 1.85 on BankNifty - and the far wings are poor signal in any
# case: much of that activity is spread legs and margin-relief hedges,
# which say nothing about direction.
#
# 1.5 covers the strikes price can realistically reach plus the walls just
# beyond. Lower it to 1.0 for tighter, near-the-money flow only.
NSE_FLOW_SIGMA=1.5
FYERS_DEPTH_STRIKES=10

# ── Fyers API usage (added 2026-10-07, ahead of API charges) ─────────
# Option-chain REST response is shared across bands/expiries for this long;
# strike prices and OI between refreshes come from the live stream.
FYERS_CHAIN_REST_TTL=15
# Futures OI / prev close refreshed this often (price is streamed live).
FYERS_FUT_REST_TTL=60
# A streamed price older than this is treated as stale and re-fetched.
FYERS_TICK_FRESH_S=15
# Intraday history cache; the forming candle comes from the stream.
FYERS_HISTORY_TTL=60

# ── Zerodha Kite Connect ─────────────────────────────────────────────
# Set DATA_SOURCE=zerodha to use it (DATA_SOURCE may be nse, fyers,
# zerodha or arrow). Needs a Kite Connect app on the paid Connect plan -
# the free Personal plan carries no live or historical data. Create one
# at https://developers.kite.trade and paste its key and secret below.
# Tokens expire DAILY (~06:00 IST) and the login is interactive, so run:
#     python3 zerodha_login.py
# each morning - the server runs it for you at startup when needed. It
# writes .zerodha_token, which the adapter reads.
ZERODHA_API_KEY=g0zo9ykwec29xz7g
ZERODHA_API_SECRET=2q80fu6jefnsp3jqn4cp1tph9b3c8zme
# Set the SAME address as the redirect URL of your Kite app; the login
# then completes by itself instead of asking you to paste the address.
ZERODHA_REDIRECT_URL=http://127.0.0.1:5010/kite
# Optional: paste a token directly instead of using the token file.
ZERODHA_ACCESS_TOKEN=
# Where zerodha_login.py also drops a PLAIN-TEXT copy of the token
# (zerodha_access_token.txt), relative to the login script.
ZERODHA_SYNC_DIR=../NSE_SYNC
# Run zerodha_login.py at server start when today's token is missing.
NSE_ZERODHA_AUTO_LOGIN=true
# Indices primed and streamed at startup, and strikes either side of ATM.
ZERODHA_SYMBOLS=NIFTY,BANKNIFTY
ZERODHA_STRIKE_COUNT=25
# Tick pushes to browsers per second (coalesced).
ZERODHA_PUSH_HZ=10
# REST quotes fill in only what the stream has not delivered; reused this
# long (5 min while the market is closed). Kite allows 1 quote call/s.
ZERODHA_CHAIN_REST_TTL=15
ZERODHA_FUT_REST_TTL=60
# A streamed price older than this is treated as stale.
ZERODHA_TICK_FRESH_S=15
# Intraday history cache; the forming candle comes from the stream.
ZERODHA_HISTORY_TTL=60
# Kite's index candles carry no volume; 'futures' lays the near-month
# future's volume on them (VWAP, volume profile, PVSRA). 'none' = off.
ZERODHA_INDEX_VOLUME=futures
# Kite publishes no previous-day OI. It is recorded at each close; any
# contract still missing is back-filled once a day from daily candles.
ZERODHA_OI_BACKFILL=1
# Leave blank: OI/volume units are detected from the data (shares vs contracts).
ZERODHA_QTY_UNIT=
