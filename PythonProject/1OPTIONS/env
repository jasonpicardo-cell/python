# ══════════════════════════════════════════════════════════════════════
#  1OPTIONS — data source configuration
#
#  Copy this file next to nse_chain_server.py and edit. It is read at
#  startup; command-line flags still override anything set here.
#  Keep it out of version control: it holds broker credentials.
# ══════════════════════════════════════════════════════════════════════

# ── Which market-data adapter to use ─────────────────────────────────
#   nse    = scrape NSE's public option chain (no account, ~3-5 min stale
#            OI, needs the cookie warm-up, polled on a timer)
#   arrow  = Arrow / iRage broker API (real-time, WebSocket streaming,
#            OI + Greeks + volume; polling is switched OFF automatically)

#Set DATA_SOURCE=fyers and restart. Verified the server boots correctly on that setting: NSE polling disabled, and a clear message when unconfigured.
DATA_SOURCE=fyers

# ── Fyers API v3 ─────────────────────────────────────────────────────
# The richest source available here: real-time WebSocket ticks, genuine OHLC
# with TRADED VOLUME, bid/ask per strike and Level-2 market depth. Set
# DATA_SOURCE=fyers to use it.
#
# Create an app at https://myapi.fyers.in to get the id and secret. Access
# tokens expire DAILY and the login is interactive, so run:
#     python3 fyers_login.py
# each morning - it writes .fyers_token, which the adapter reads.
FYERS_CLIENT_ID=X2VQ4FPOO3-100
FYERS_SECRET_KEY=E857FEHMKY
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html
# Optional: paste a token directly instead of using the token file.
FYERS_ACCESS_TOKEN=
# Indices to stream, and strikes either side of ATM.
FYERS_SYMBOLS=NIFTY,BANKNIFTY
FYERS_STRIKE_COUNT=25
# Tick pushes to browsers per second (coalesced; the UI cannot use more).
FYERS_PUSH_HZ=4

# ── Arrow (arrow.trade / iRage Broking) ──────────────────────────────
# Create an app in Arrow's Trading API section to get these.
ARROW_APP_ID=
ARROW_API_SECRET=

# Unattended daily login (auto_login with TOTP). Preferred for a server
# that restarts on its own: no token pasting each morning.
ARROW_USER_ID=
ARROW_PASSWORD=
ARROW_TOTP_SECRET=

# Alternative: paste a token obtained manually. Used only when the
# auto-login fields above are blank. Tokens are short-lived.
ARROW_ACCESS_TOKEN=

# Underlyings to stream, and how many strikes either side of ATM.
ARROW_SYMBOLS=NIFTY,BANKNIFTY
ARROW_STRIKE_COUNT=20

# Seconds between option-chain refreshes when streaming is unavailable.
# Arrow's chain endpoint is REST; the WebSocket carries the live ticks.
ARROW_CHAIN_INTERVAL=3

# ── Server ───────────────────────────────────────────────────────────
NSE_LAN=true
NSE_PORT=8765
NSE_CHAIN_TTL=8

# Fill chart gaps from Yahoo Finance when NSE data is missing (no account
# needed). Never overwrites NSE prices - gap-fill only. false = honest gaps.
NSE_YAHOO_BACKFILL=true

# Background poller — only meaningful for DATA_SOURCE=nse.
# It is force-disabled when an adapter streams its own data.
NSE_POLL=NIFTY,BANKNIFTY
NSE_POLL_INTERVAL=5

# ── Alert engine thresholds ──────────────────────────────────────────
NSE_ALERT_OI_PCT=3
NSE_ALERT_PREM_PCT=6
NSE_ALERT_NEAR_PCT=1.5
NSE_ALERT_WINDOW=90
NSE_ALERT_COOLDOWN=300
NSE_ALERT_MAX=6
NSE_ALERT_MIN_OI=4000
